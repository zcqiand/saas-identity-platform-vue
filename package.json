{
  "name": "saas-identity-platform-vue",
  "version": "0.1.0",
  "description": "SaaS Identity Platform — Vue 3.5 + Vite + TS. Consumes @saas/identity-platform-shared TypeSpec codegen.",
  "type": "module",
  "scripts": {
    "gen:shared": "tsx scripts/gen-shared.ts",
    "prebuild": "npm run gen:shared",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src tests --ext .ts,.vue",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@saas/identity-platform-shared": "file:../saas-identity-platform-shared",
    "@tanstack/vue-query": "^5.62.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@saas/identity-platform-msw": "file:../saas-identity-platform-msw",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.10"
  }
}
