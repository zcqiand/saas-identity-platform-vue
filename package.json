{
  "name": "saas-identity-platform-vue",
  "version": "1.0.0",
  "private": true,
  "description": "《Vue从入门到项目实践》案例二：SaaS 多租户统一身份管理系统配套可运行工程（React 双栈对照）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
