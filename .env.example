# saas-identity-platform-vue 环境变量示例。复制为 .env 后填写。
# 缺省全部留空即可：工程默认走 MSW mock 后端 + 前端模拟 JWT，无 Key/无 Docker/无网可跑测试。
#
# 与 saas-identity-platform（React）/.env.example 对齐：
# - VITE_* 前缀 = 浏览器可读（import.meta.env）
# - SAAS_* 前缀无 VITE_ = Node / 构建时读；vite proxy target 走 SAAS_BACKEND_URL env
#
# 启动：npm run dev（vite 默认 5173；端口被占时 +1）
# 浏览器开 http://localhost:5173/
# → 默认 msw SW 拦截同源 /api/* 不需后端；proxy 仅兜底
# → 生产端改为 SAAS_BACKEND_URL=https://api.xiangru.uk（真实后端或 nginx 反代）

# —— 应用元信息 ——
VITE_APP_TITLE=SaaS 多租户身份平台（Vue）

# —— API 基础地址（默认走 MSW 拦截，无需真实后端）——
VITE_API_BASE_URL=/api

# —— SSO 授权服务器地址（默认走 MSW 模拟 IdP）——
VITE_SSO_BASE_URL=/sso
VITE_SSO_CLIENT_ID=saas-demo-client

# —— OAuth2 提供商配置（默认走 MSW 模拟 IdP）——
VITE_OAUTH_GITHUB_CLIENT_ID=github-demo-client
VITE_OAUTH_REDIRECT_URI=/oauth/callback

# —— 离线开关：1 强制走 MSW mock，CI 默认 1 ——
VITE_OFFLINE=1

# —— mock JWT 签发密钥（仅 mock 层使用，非真实凭证，勿用于生产）——
VITE_MOCK_JWT_SECRET=saas-mock-secret-not-for-production

# == 进程端口（与 saas-react SAAS_API_PORT 镜像） ==
# Vite dev server 端口。前端 5173；端口被占时 vite 自动 +1。
# 注：saas-vue 没自起 dev-server（用 msw 拦截），所以只用 vite port env。
SAAS_VITE_PORT=5173

# == dev vite proxy 真实后端回退（msw 漏网的兜底） ==
# dev 默认 localhost:8080（DevOps 常用端口）；生产 nginx 反代或真实域名。
SAAS_BACKEND_URL=http://localhost:8080
